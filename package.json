{
  "name": "shopease",
  "version": "1.0.0",
  "private": true,
  "description": "ShopEase Full-Stack MERN E-Commerce Platform",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:server": "npm --workspace=server run dev",
    "dev:client": "npm --workspace=client run dev",
    "build": "npm install --include=dev && npm --workspace=client run build",
    "build:client": "npm --workspace=client run build",
    "start": "npm --workspace=server run start",
    "start:server": "npm --workspace=server run start",
    "seed": "npm --workspace=server run seed",
    "test": "npm --workspace=server run test"
  }
}
