{
  "name": "shopease",
  "version": "1.0.0",
  "private": true,
  "description": "ShopEase Full-Stack MERN E-Commerce Platform",
  "workspaces": [
    "Frontend",
    "Backend"
  ],
  "scripts": {
    "dev:backend": "npm --workspace=Backend run dev",
    "dev:frontend": "npm --workspace=Frontend run dev",
    "dev:server": "npm --workspace=Backend run dev",
    "dev:client": "npm --workspace=Frontend run dev",
    "build": "npm install --include=dev && npm --workspace=Frontend run build",
    "build:client": "npm --workspace=Frontend run build",
    "start": "npm --workspace=Backend run start",
    "start:server": "npm --workspace=Backend run start",
    "seed": "npm --workspace=Backend run seed",
    "test": "npm --workspace=Backend run test"
  }
}
